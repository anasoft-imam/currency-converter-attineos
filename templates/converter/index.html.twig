{% extends 'base.html.twig' %}

{% block title %}Convertisseur de devises | Currency Converter{% endblock %}

{% block body %}
    <header class="topbar">
        <a class="brand" href="{{ path('app_converter') }}">
            <span class="brand-mark" aria-hidden="true">↗</span>
            <span>Currency Converter</span>
        </a>

        <a class="logout-link" href="{{ path('app_logout') }}">
            Se déconnecter
        </a>
    </header>

    <main class="page">
        <div class="page-heading">
            <p class="eyebrow">Simple · Rapide · Fiable</p>
            <h1>Convertisseur de devises</h1>
            <p class="subtitle">
                Consultez les taux de change et convertissez vos montants
                en quelques secondes.
            </p>
        </div>

        <section class="converter-card" aria-label="Conversion de devises">
            {% if error %}
                <div class="alert" role="alert">{{ error }}</div>
            {% endif %}

            <form
                id="converter-form"
                method="post"
                action="{{ path('app_converter_submit') }}"
            >
                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('currency_conversion') }}"
                >

                <div class="field">
                    <label for="amount">Montant à convertir</label>
                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        min="0.01"
                        step="0.01"
                        value="{{ amount }}"
                        required
                    >
                </div>

                <div class="currency-grid">
                    <div class="field">
                        <label for="from">Devise d’origine</label>
                        <select id="from" name="from" required>
                            {% for code, currency in currencies %}
                                <option
                                    value="{{ code }}"
                                    {% if code == from %}selected{% endif %}
                                >
                                    {{ code }} — {{ currency.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="field">
                        <label for="to">Devise cible</label>
                        <select id="to" name="to" required>
                            {% for code, currency in currencies %}
                                <option
                                    value="{{ code }}"
                                    {% if code == to %}selected{% endif %}
                                >
                                    {{ code }} — {{ currency.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <button
                    id="convert-button"
                    class="primary-button"
                    type="submit"
                >
                    <span class="button-label">
                        Convertir le montant →
                    </span>
                    <span
                        class="button-loading"
                        hidden
                        aria-hidden="true"
                    >
                        <span class="button-spinner"></span>
                        Conversion en cours...
                    </span>
                </button>

                <p
                    id="conversion-status"
                    class="visually-hidden"
                    role="status"
                    aria-live="polite"
                ></p>
            </form>

            {% if result is not null and rate is not null %}
                <section class="result-card" aria-live="polite">
                    <p class="result-label">Montant après conversion</p>

                    <p class="result-amount">
                        {{ result|number_format(2, ',', ' ') }} {{ to }}
                    </p>

                    <p class="result-equation">
                        {{ amount|number_format(2, ',', ' ') }} {{ from }}
                        = {{ result|number_format(2, ',', ' ') }} {{ to }}
                    </p>

                    <p class="rate-note">
                        Taux appliqué : 1 {{ from }} =
                        {{ rate|number_format(6, ',', ' ') }} {{ to }}.
                        Taux de change fourni par Frankfurter.
                    </p>
                </section>
            {% endif %}
        </section>

        <p class="footer">
            Les taux peuvent varier au fil du temps.
            Les résultats sont fournis à titre indicatif.
        </p>
    </main>

    <style>
        .button-loading[hidden] {
            display: none !important;
        }

        .button-loading:not([hidden]) {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .button-spinner {
            width: 16px;
            height: 16px;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: converter-spin 0.7s linear infinite;
        }

        .primary-button:disabled {
            opacity: 0.75;
            cursor: wait;
        }

        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        @keyframes converter-spin {
            to {
                transform: rotate(360deg);
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .button-spinner {
                animation-duration: 2s;
            }
        }
    </style>

    <script>
        (() => {
            const form = document.getElementById('converter-form');
            const button = document.getElementById('convert-button');
            const label = button?.querySelector('.button-label');
            const loading = button?.querySelector('.button-loading');
            const status = document.getElementById('conversion-status');

            if (!form || !button || !label || !loading || !status) {
                return;
            }

            form.addEventListener('submit', () => {
                // Submit fires only after native HTML form validation.
                // Defer disabling the button so its submission proceeds.
                window.setTimeout(() => {
                    button.disabled = true;
                    button.setAttribute('aria-busy', 'true');
                    label.hidden = true;
                    loading.hidden = false;
                    status.textContent = 'Conversion en cours...';
                }, 0);
            });

            // Restore the button when returning via browser back/forward cache.
            window.addEventListener('pageshow', () => {
                button.disabled = false;
                button.removeAttribute('aria-busy');
                label.hidden = false;
                loading.hidden = true;
                status.textContent = '';
            });
        })();
    </script>
{% endblock %}
