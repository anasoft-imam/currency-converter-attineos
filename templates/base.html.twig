
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Currency Converter{% endblock %}</title>
    <meta name="description" content="Convertissez vos devises avec les taux de change de Frankfurter.">

    <style>
        :root {
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
            color: #172033;
            background: #f4f7fb;
            font-synthesis: none;
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
        }

        a {
            color: inherit;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 22px max(24px, calc((100% - 1080px) / 2));
            background: #fff;
            border-bottom: 1px solid #e7ebf2;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            font-size: 17px;
            font-weight: 750;
            letter-spacing: -0.4px;
            text-decoration: none;
        }

        .brand-mark {
            display: grid;
            place-items: center;
            width: 36px;
            height: 36px;
            border-radius: 11px;
            color: #fff;
            background: #3157d5;
            font-size: 19px;
        }

        .logout-link {
            color: #566178;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        .logout-link:hover {
            color: #3157d5;
        }

        .page {
            width: min(100% - 32px, 720px);
            margin: 64px auto;
        }

        .page-heading {
            margin-bottom: 28px;
            text-align: center;
        }

        .eyebrow {
            margin: 0 0 12px;
            color: #3157d5;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            font-size: clamp(29px, 5vw, 40px);
            font-weight: 780;
            letter-spacing: -1.6px;
        }

        .subtitle {
            max-width: 470px;
            margin: 14px auto 0;
            color: #69748a;
            font-size: 15px;
            line-height: 1.7;
        }

        .converter-card {
            padding: 32px;
            border: 1px solid #e6eaf1;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 16px 48px rgb(31 48 83 / 7%);
        }

        .field {
            margin-bottom: 22px;
        }

        .field label {
            display: block;
            margin-bottom: 9px;
            color: #39445b;
            font-size: 13px;
            font-weight: 700;
        }

        .field input,
        .field select {
            display: block;
            width: 100%;
            min-height: 50px;
            padding: 0 14px;
            border: 1px solid #dce2ed;
            border-radius: 10px;
            outline: none;
            background: #fff;
            color: #172033;
            font: inherit;
            font-size: 15px;
            transition: border-color .15s, box-shadow .15s;
        }

        .field input:focus,
        .field select:focus {
            border-color: #3157d5;
            box-shadow: 0 0 0 3px rgb(49 87 213 / 12%);
        }

        .currency-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .primary-button {
            display: block;
            width: 100%;
            min-height: 52px;
            margin-top: 8px;
            border: 0;
            border-radius: 11px;
            background: #3157d5;
            color: #fff;
            font: inherit;
            font-size: 15px;
            font-weight: 750;
            cursor: pointer;
            transition: background .15s, transform .15s;
        }

        .primary-button:hover {
            background: #2546b7;
        }

        .primary-button:active {
            transform: translateY(1px);
        }

        .alert {
            margin-bottom: 22px;
            padding: 13px 15px;
            border: 1px solid #fecaca;
            border-radius: 10px;
            background: #fff1f2;
            color: #b42332;
            font-size: 14px;
            line-height: 1.5;
        }

        .result-card {
            margin-top: 24px;
            padding: 24px;
            border: 1px solid #dbe4ff;
            border-radius: 14px;
            background: #f5f7ff;
        }

        .result-label {
            margin: 0 0 12px;
            color: #596680;
            font-size: 13px;
            font-weight: 700;
        }

        .result-amount {
            margin: 0;
            color: #2546b7;
            font-size: clamp(27px, 5vw, 36px);
            font-weight: 800;
            letter-spacing: -1px;
            overflow-wrap: anywhere;
        }

        .result-equation {
            margin: 12px 0 0;
            color: #58647c;
            font-size: 14px;
        }

        .rate-note {
            margin: 18px 0 0;
            padding-top: 16px;
            border-top: 1px solid #dbe4ff;
            color: #58647c;
            font-size: 12px;
            line-height: 1.6;
        }

        .footer {
            margin: 26px 0 0;
            color: #8a94a8;
            font-size: 12px;
            text-align: center;
        }

        @media (max-width: 540px) {
            .topbar {
                padding: 16px;
            }

            .page {
                margin: 38px auto;
            }

            .converter-card {
                padding: 22px 18px;
                border-radius: 15px;
            }

            .currency-grid {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }


        /* Pages d'authentification */
        .auth-page {
            width: min(100% - 40px, 460px);
            margin: 64px auto 32px;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e8edf5;
            border-radius: 20px;
            padding: 36px;
            box-shadow: 0 16px 45px rgba(31, 55, 90, 0.08);
        }

        .auth-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 24px;
            border-radius: 16px;
            background: #eaf2ff;
            color: #2563eb;
            font-size: 28px;
            font-weight: 700;
        }

        .auth-card .eyebrow {
            margin-bottom: 8px;
        }

        .auth-card h1 {
            margin: 0;
            color: #172033;
            font-size: 30px;
            line-height: 1.25;
            letter-spacing: -0.7px;
        }

        .auth-subtitle {
            margin: 12px 0 28px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
        }

        .auth-card form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .auth-card .field input {
            width: 100%;
            box-sizing: border-box;
        }

        .auth-card .primary-button {
            width: 100%;
            margin-top: 4px;
        }

        .auth-footer {
            margin: 26px 0 0;
            color: #64748b;
            text-align: center;
            font-size: 14px;
        }

        .auth-card a {
            color: #2563eb;
            font-weight: 600;
            text-decoration: none;
        }

        .auth-card a:hover {
            text-decoration: underline;
        }

        .auth-notice {
            color: #475569;
            font-size: 14px;
            line-height: 1.7;
        }

        @media (max-width: 520px) {
            .auth-page {
                margin-top: 32px;
            }

            .auth-card {
                padding: 26px 22px;
                border-radius: 16px;
            }

            .auth-card h1 {
                font-size: 26px;
            }
        }


        .auth-card .terms-field {
            display: flex;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 10px;
            color: #475569;
            font-size: 13px;
            line-height: 1.5;
        }

        .auth-card .terms-field input[type="checkbox"] {
            margin-top: 3px;
            accent-color: #2563eb;
        }

        .auth-card .terms-field label {
            flex: 1;
            cursor: pointer;
        }

        .auth-card .field ul,
        .auth-card > ul {
            margin: 6px 0 0;
            padding-left: 18px;
            color: #dc2626;
            font-size: 13px;
        }

    </style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
